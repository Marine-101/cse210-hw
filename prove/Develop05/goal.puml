@startuml Goal

abstract class Goal
{
    - _name : string
    - _description : string
    - _points : int

    + Goal(name : string, description : string, points : int)
    + GetName() : string
    + GetDescription() : string
    + GetPoints() : int
    + IsComplete() : bool
    + RecordEvent() : int
    + GetDetailsString() : string
}

class SimpleGoal
{
    - _isComplete : bool

    + SimpleGoal(name : string, description : string, points : int)
    + RecordEvent() : int
    + IsComplete() : bool
    + GetDetailsString() : string
}

class EternalGoal
{
    + EternalGoal(name : string, description : string, points : int)
    + RecordEvent() : int
    + IsComplete() : bool
    + GetDetailsString() : string
}

class ChecklistGoal
{
    - _amountCompleted : int
    - _targetAmount : int
    - _bonus : int

    + ChecklistGoal(name : string, description : string, points : int, target : int, bonus : int)
    + RecordEvent() : int
    + IsComplete() : bool
    + GetDetailsString() : string
}

class Program
{
    - _goals : List<Goal>
    - _score : int

    + Main()
    + DisplayMenu()

}

Goal <|-- SimpleGoal
Goal <|-- EternalGoal
Goal <|-- ChecklistGoal

Program "1" o-- "*" Goal

@enduml