@startuml journal

class Program {
    + Main()
    + DisplayMenu()
}

class Journal {
    - entries : List<Entry>

    + AddEntry()
    + DisplayEntries()
    + SaveToFile()
    + LoadFromFile()
}

class Entry {
    - date : string
    - prompt : string
    - response : string

    + Display()
}

class PromptGenerator {
    - prompts : List<string>

    + GetRandomPrompt()
}

Journal --> PromptGenerator
Program --> Journal
Journal "1" --> "*" Entry

@enduml
